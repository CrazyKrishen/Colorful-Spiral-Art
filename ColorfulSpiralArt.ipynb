   "source": [
    "import turtle\n",
    "\n",
    "t = turtle.Turtle()\n",
    "t.speed(0)\n",
    "turtle.bgcolor(\"black\")\n",
    "colors = [\"red\",\"yellow\",\"blue\",\"green\",\"purple\",\"orange\"]\n",
    "\n",
    "for i in range(200):\n",
    "    t.color(colors[i%6])\n",
    "    t.circle(i)\n",
    "    t.left(59)\n",
    "\n",
    "turtle.done()"
   ]
